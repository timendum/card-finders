default: help

help:
  @just --list --unsorted

# install dependencies
install:
  @echo "==> install"
  bun install

# produce the production build (type-checks first)
build:
  @echo "==> build"
  bun run build

# dev server (hot reload). Supports extra args, e.g. just dev --port 3000
dev *ARGS:
  @echo "==> dev server"
  bun run dev {{ARGS}}

# preview the production build locally
preview *ARGS: build
  @echo "==> preview production build"
  bun run preview {{ARGS}}

# run tests. Supports extra args, e.g. just test handSort
test *ARGS:
  @echo "==> test"
  bun run test {{ARGS}}

# type-check without emitting
typecheck:
  @echo "==> typecheck"
  bun run typecheck

# lint with oxlint. Supports extra args, e.g. just lint --fix
lint *ARGS:
  @echo "==> lint"
  bunx oxlint {{ARGS}}

# format with oxfmt
fmt *ARGS:
  @echo "==> format"
  bunx oxfmt . {{ARGS}}

# verify formatting (fails if any file needs formatting)
fmt-check:
  @echo "==> format check"
  bunx oxfmt --check .

format: fmt

# sanity checks
checks: lint typecheck test fmt-check

# remove build output
clean:
  @echo "==> clean"
  rm -rf dist
